# CẤU HÌNH MQTT CLOUD BROKER
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=my_iot_project/stm32_sensor_data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# CẤU HÌNH THỜI GIAN TIMEOUT MẤT KẾT NỐI (PHÚT)
TIMEOUT_MINUTES=2.0

# CẤU HÌNH REST API SERVER
API_HOST=0.0.0.0
API_PORT=5000

# CƠ SỞ DỮ LIỆU (ĐỂ TRỐNG ĐỂ DÙNG SQLITE CỤC BỘ, HOẶC ĐIỀN CHUỖI POSTGRESQL SUPABASE)
DB_PATH=rainfall_data.db
DATABASE_URL=

# MÃ QUẢN TRỊ CHO CÁC API XÓA / GIẢ LẬP (HEADER: X-Admin-Token)
ADMIN_API_KEY=
