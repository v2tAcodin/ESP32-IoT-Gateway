# CẤU HÌNH MQTT CLOUD BROKER
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=my_iot_project/stm32_sensor_data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# CẤU HÌNH THỜI GIAN TIMEOUT MẤT KẾT NỐI (PHÚT)
TIMEOUT_MINUTES=10

# CẤU HÌNH REST API SERVER
API_HOST=0.0.0.0
API_PORT=5000

# TÊN FILE CƠ SỞ DỮ LIỆU SQLITE
DB_PATH=rainfall_data.db
